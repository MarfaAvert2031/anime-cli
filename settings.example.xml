<settings>
    <apis>
        <api>
            <name>Jikan</name>
            <url>https://api.jikan.moe/v4/anime</url>
            <type>rest</type>
            <results_path>data</results_path>
            <title_field>title</title_field>
            <episodes_field>episodes</episodes_field>
            <query_param>q</query_param>
            <status_field>status</status_field>
            <score_field>score</score_field>
            <year_field>year</year_field>
        </api>
        <api>
            <name>AniList</name>
            <url>https://graphql.anilist.co</url>
            <type>graphql</type>
            <results_path>data.Page.media</results_path>
            <title_field>title.romaji</title_field>
            <episodes_field>episodes</episodes_field>
            <query_param>q</query_param>
            <status_field>status</status_field>
            <score_field>averageScore</score_field>
            <year_field>seasonYear</year_field>
        </api>
        <api>
            <name>MyCustomAPI</name>
            <url>https://example.com/api/search</url>
            <type>rest</type>
            <results_path>results</results_path>
            <title_field>name</title_field>
            <episodes_field>episode_count</episodes_field>
            <query_param>q</query_param>
        </api>
    </apis>
    <streaming_apis>
        <api>
            <name>Kuhi</name>
            <url>http://127.0.0.1:8000</url>
            <type>rest</type>
            <search_path>/anime/search</search_path>
            <query_param>query</query_param>
            <episodes_path>/anime/episodes/{anilist_id}</episodes_path>
            <extract_path>/anime/extract/{anilist_id}</extract_path>
            <info_path>/anime/info/{anilist_id}</info_path>
            <info_fields>title,status,episodes</info_fields>
            <episode_param>e</episode_param>
            <audio_param>type</audio_param>
            <default_audio>sub</default_audio>
            <results_path>results</results_path>
            <streams_field>streams</streams_field>
            <stream_url_field>url</stream_url_field>
            <stream_type_field>type</stream_type_field>
            <referer_field>referer</referer_field>
            <enabled>true</enabled>
        </api>
        <api>
            <name>JustalK</name>
            <type>node-library</type>
            <package>@justalk/anime-api</package>
            <website>ANIMEOUT</website>
            <methods>links,stream,download</methods>
            <enabled>true</enabled>
        </api>
    <api>
        <name>HdRezka</name>
        <type>node-library</type>
        <package>HDrezka</package>
        <base_url>https://hdrezka.ag</base_url>
        <proxy></proxy>
        <default_quality>720p</default_quality>
        <enabled>true</enabled>
    </api>
 </streaming_apis>
 </settings>